generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String
  role                String
  phone               String?
  profilePicture      String?
  preferences         String?
  lastActive          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  generalFeedback     Feedback[]
  fieldNotes          FieldNote[]
  assignedAsWorker    Household[]
  notifications       Notification[]
  reliefDistributions ReliefDistribution[]
  feedback            ReliefFeedback[]
  vulnerableProfile   VulnerableProfile?
}

model VulnerableProfile {
  id                         String                  @id @default(cuid())
  userId                     String                  @unique
  lastName                   String
  firstName                  String
  middleName                 String?
  suffix                     String?
  dateOfBirth                DateTime?
  gender                     String?
  civilStatus                String?
  mobileNumber               String
  landlineNumber             String?
  emailAddress               String
  houseNumber                String
  street                     String
  barangay                   String
  municipality               String
  province                   String
  latitude                   Float?
  longitude                  Float?
  educationalAttainment      String?
  employmentStatus           String?
  employmentDetails          String?
  vulnerabilityTypes         String
  disabilityType             String?
  disabilityCause            String?
  disabilityIdNumber         String?
  emergencyContact           String?
  emergencyPhone             String?
  hasMedicalCondition        Boolean                 @default(false)
  medicalConditions          String?
  needsAssistance            Boolean                 @default(false)
  assistanceType             String?
  hasRepresentative          Boolean                 @default(false)
  representativeName         String?
  representativeRelationship String?
  representativePhone        String?
  representativeEmail        String?
  hasAuthorizationLetter     Boolean                 @default(false)
  registrationStatus         String                  @default("PENDING")
  rejectionReason            String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  household                  Household?
  reliefDistributions        ReliefDistribution[]
  documents                  VulnerabilityDocument[]
  user                       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VulnerabilityDocument {
  id           String            @id @default(cuid())
  profileId    String
  documentType String
  fileName     String
  fileUrl      String
  uploadedAt   DateTime          @default(now())
  profile      VulnerableProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Household {
  id                  String               @id @default(cuid())
  address             String
  barangay            String
  latitude            Float
  longitude           Float
  headOfHousehold     String?
  totalMembers        Int                  @default(1)
  vulnerableMembers   Int                  @default(0)
  assignedWorkerId    String?
  vulnerableProfileId String?              @unique
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  vulnerableProfile   VulnerableProfile?   @relation(fields: [vulnerableProfileId], references: [id])
  assignedWorker      User?                @relation(fields: [assignedWorkerId], references: [id])
  reliefDistributions ReliefDistribution[]
}

model ReliefDistribution {
  id                  String             @id @default(cuid())
  householdId         String?
  vulnerableProfileId String?
  workerId            String
  distributionDate    DateTime           @default(now())
  distributionType    String
  itemsProvided       String
  quantity            Int
  notes               String?
  status              String             @default("PENDING")
  rejectionReason     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  worker              User               @relation(fields: [workerId], references: [id])
  vulnerableProfile   VulnerableProfile? @relation(fields: [vulnerableProfileId], references: [id])
  household           Household?         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  feedback            ReliefFeedback[]
}

model ReliefFeedback {
  id                   String             @id @default(cuid())
  reliefDistributionId String
  userId               String
  feedbackType         String
  message              String
  status               String             @default("SUBMITTED")
  adminResponse        String?
  adminResponseDate    DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reliefDistribution   ReliefDistribution @relation(fields: [reliefDistributionId], references: [id], onDelete: Cascade)
}

model CommunityResource {
  id          String   @id @default(cuid())
  name        String
  type        String
  address     String
  barangay    String
  latitude    Float
  longitude   Float
  capacity    Int?
  contactInfo String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FieldNote {
  id        String   @id @default(cuid())
  userId    String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id           String    @id @default(cuid())
  userId       String
  type         String
  title        String
  message      String
  status       String    @default("PENDING")
  sentViaEmail Boolean   @default(false)
  sentViaSms   Boolean   @default(false)
  emailSentAt  DateTime?
  smsSentAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminSignupRequest {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String
  position        String
  reason          String
  status          String    @default("PENDING")
  rejectionReason String?
  requestedBy     String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Announcement {
  id         String    @id @default(cuid())
  title      String
  content    String
  type       String
  targetRole String?
  eventDate  DateTime?
  eventTime  String?
  location   String?
  isActive   Boolean   @default(true)
  priority   String    @default("NORMAL")
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Feedback {
  id                String    @id @default(cuid())
  userId            String
  type              String
  subject           String?
  message           String
  status            String    @default("SUBMITTED")
  adminResponse     String?
  adminResponseDate DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
